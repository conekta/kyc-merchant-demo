# Copia este archivo a .env y completa los valores. Nunca subas .env.

# Llave privada de staging. SIN prefijo VITE_: solo la lee el middleware de Vite, nunca entra al bundle.
CONEKTA_PRIVATE_KEY=key_PEGA_AQUI_TU_LLAVE_PRIVADA_DE_STAGING

# Llave pública (el loader solo valida el formato ^key_[A-Za-z0-9_]{8,64}$)
VITE_CONEKTA_PUBLIC_KEY=key_xxxxxxxxxxxxxxxx

# Origen de ct-kyc-fe: staging por defecto, o https://localhost:9092 para local
VITE_KYC_BASE_URL=https://kyc.stg.conekta.io
