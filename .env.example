# Copia este archivo a .env y completa los valores. Nunca subas .env.
# Son las mismas variables que recibe la imagen (Dockerfile) en el pod.

# Llave privada de staging. Solo la lee el servidor (middleware de Vite o server/main.ts), nunca entra al bundle.
CONEKTA_PRIVATE_KEY=key_PEGA_AQUI_TU_LLAVE_PRIVADA_DE_STAGING

# Llave pública (el loader solo valida el formato ^key_[A-Za-z0-9_]{8,64}$)
CONEKTA_PUBLIC_KEY=key_xxxxxxxxxxxxxxxx

# Origen de ct-kyc-fe: staging por defecto, o https://localhost:9092 para local
KYC_BASE_URL=https://kyc.stg.conekta.io

# API donde se crea el customer (opcional; por defecto https://api.stg.conekta.io). Mismo ambiente que KYC_BASE_URL.
# CONEKTA_API_URL=https://api.stg.conekta.io
